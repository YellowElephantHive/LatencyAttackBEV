#!/bin/bash

#SBATCH --job-name=bevdet_single_cam
#SBATCH --output=logs/single_cam_master_%j.out
#SBATCH --error=logs/single_cam_master_%j.err
#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gpus-per-node=gtx_1080:1

# Refactor smoke test only (2026-11-05; not a thesis result):
# sbatch --gpus-per-node=p100:1 <this-file>

set -euo pipefail

export BEVDET_ENTRYPOINT=tools/run_bevdet_experiment.py
cd "${BEVDET_HOST_ROOT:-/project/xiaoyon/trustai/lai/BEVDet}"
# shellcheck source=experiments/bevdet_attack/lib.sh
source experiments/bevdet_attack/lib.sh

bevdet_prepare_job

# Camera index mapping:
# 0 = Front Left
# 1 = Front
# 2 = Front Right
# 3 = Back Left
# 4 = Back
# 5 = Back Right

while IFS=$'\t' read -r ATTACK_CAM CAMERA_NAME; do
  [[ -z "${ATTACK_CAM}" || "${ATTACK_CAM}" == \#* ]] && continue
  EXP_NAME="single_cam_${ATTACK_CAM}_${CAMERA_NAME}"

  EXP_STDOUT="logs/${EXP_NAME}_${SLURM_JOB_ID}.out"
  EXP_STDERR="logs/${EXP_NAME}_${SLURM_JOB_ID}.err"
  CNT_CSV="work_dirs/cnt_${EXP_NAME}_${SLURM_JOB_ID}.csv"

  echo "============================================================"
  echo "Starting experiment: ${EXP_NAME}"
  echo "Attacked camera index: ${ATTACK_CAM}"
  echo "Camera position: ${CAMERA_NAME}"
  echo "Output log: ${EXP_STDOUT}"
  echo "Error log: ${EXP_STDERR}"
  echo "Count CSV: ${CNT_CSV}"
  echo "Start time: $(date)"
  echo "============================================================"

  if [[ "${BEVDET_DRY_RUN:-0}" == 1 ]]; then
    bevdet_run "${ATTACK_CAM}" "${CNT_CSV}" attack
  else
    bevdet_run "${ATTACK_CAM}" "${CNT_CSV}" attack \
      > "${EXP_STDOUT}" 2> "${EXP_STDERR}"
  fi

  echo "Completed experiment: ${EXP_NAME}"
  echo "End time: $(date)"
  echo
done < experiments/bevdet_attack/single_camera.tsv

echo "============================================================"
echo "All six single-camera position experiments completed."
echo "Job ID: ${SLURM_JOB_ID}"
echo "Finish time: $(date)"
echo "============================================================"
